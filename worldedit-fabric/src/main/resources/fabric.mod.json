{
    "schemaVersion": 1,
    "id": "worldedit",
    "version": "${version}",

    "name": "FastAsyncWorldEdit",
    "description": "Unofficial Fabric 26.2 port of FastAsyncWorldEdit for the BRBW map editor. Not an official IntellectualSites release.",
    "authors": [
        "IntellectualSites",
        "EngineHub"
    ],

    "contributors": ["nekogabriel-bit (Fabric 26.2 port)"],
    "license": "GPL-3.0-or-later",
    "icon": "assets/worldedit/icon.png",

    "environment": "server",
    "entrypoints": {
        "main": [
            "com.sk89q.worldedit.fabric.internal.FabricWorldEdit"
        ]
    },

    "depends": {
        "fabricloader": ">=0.19.0",
        "minecraft": "26.2",
        "fabric-api-base": "*",
        "fabric-command-api-v2": "*",
        "fabric-lifecycle-events-v1": "*",
        "fabric-events-interaction-v0": "*",
        "fabric-networking-api-v1": "*",
        "fabric-permission-api-v1": "*"
    },
    "suggests": {
        "worldeditcui_protocol": "*",
        "fabric-permissions-api-v0": "*"
    },
    "jars": [
        {"file": "META-INF/jars/worldeditcui-protocol-common-mc26.2-4.0.3-dev.jar"},
        {"file": "META-INF/jars/worldeditcui-protocol-fabric-mc26.2-4.0.3-dev.jar"}
    ],
    "mixins": [
        "worldedit-coremc.mixins.json",
        "fawe-fabric.mixins.json"
    ]
}
